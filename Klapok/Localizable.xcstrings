    "Profiles are edited in the screenshot editor. Settings only manages the stored set." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile werden im Bildeditor bearbeitet. Einstellungen verwaltet nur die gespeicherte Sammlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles se editan en el editor de imágenes. Ajustes solo administra la colección guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
