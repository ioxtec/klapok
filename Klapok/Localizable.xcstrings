    "H.264 is safest. HEVC can create smaller files on newer Macs." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 ist am kompatibelsten. HEVC kann auf neueren Macs kleinere Dateien erzeugen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 es más compatible. HEVC puede crear archivos menores en Macs recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 offre la meilleure compatibilité. HEVC réduit la taille sur les Mac récents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 è il più compatibile. HEVC può creare file più piccoli sui Mac recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264は互換性が高く、HEVCは新しいMacでファイルを小さくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264는 호환성이 높습니다. HEVC는 최신 Mac에서 파일 크기를 줄일 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 jest najbezpieczniejszy. HEVC może tworzyć mniejsze pliki na nowszych Macach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 é mais compatível. HEVC pode gerar arquivos menores em Macs recentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 兼容性最好。HEVC 可在较新的 Mac 上生成更小的文件。"
