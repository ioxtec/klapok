    "capture_pixel_mode_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reale Bildschirmgröße verwendet physische Pixel. Skalierte Größe verwendet logische macOS-Punkte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real screen size records physical display pixels. Scaled screen size uses macOS logical points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño real usa píxeles físicos. El escalado usa puntos lógicos de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille réelle utilise les pixels physiques. La taille mise à l’échelle utilise les points logiques de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione reale usa pixel fisici. Quella ridimensionata usa punti logici di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の画面サイズでは物理ピクセル、拡大縮小サイズではmacOSの論理ポイントを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 화면 크기는 물리적 픽셀을, 조정된 크기는 macOS 논리 포인트를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzeczywisty rozmiar zapisuje fizyczne piksele ekranu. Skalowany rozmiar używa logicznych punktów macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho real usa pixels físicos. O dimensionado usa pontos lógicos do macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实际屏幕尺寸使用物理像素，缩放尺寸使用 macOS 逻辑点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
