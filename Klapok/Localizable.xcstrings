    "Real screen size writes physical pixels. Scaled screen size uses the macOS logical size." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reale Bildschirmgröße schreibt physische Pixel. Skalierte Größe verwendet die logische macOS-Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño real guarda píxeles físicos. El escalado usa el tamaño lógico de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille réelle utilise les pixels physiques. La taille mise à l’échelle utilise les dimensions logiques de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione reale salva pixel fisici. Quella ridimensionata usa le dimensioni logiche di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の画面サイズで物理ピクセルを保存します。拡大縮小サイズではmacOSの論理サイズを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 화면 크기는 물리적 픽셀로 저장합니다. 조정된 크기는 macOS 논리적 크기를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzeczywisty rozmiar zachowuje fizyczne piksele. Skalowany rozmiar używa logicznych wymiarów macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho real salva pixels físicos. O dimensionado usa o tamanho lógico do macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实际屏幕尺寸写入物理像素，缩放尺寸使用 macOS 逻辑尺寸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
